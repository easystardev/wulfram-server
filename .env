WULFRAM_CORRECTION_INTERVAL=0
WULFRAM_SEND_PLAYER_UPDATES=1
WULFRAM_UPDATE_HEARTBEAT=0.1
# HEARTBEAT_ROT MUST be 0 for OG clients: =1 puts real single-entity rotation in the
# heartbeat UPDATE_ARRAY, which triggers the client's sync_local_player and FREEZES local
# movement (~30s in, while firing/fuel still work). The launcher set this; .env did not, so
# DO ran the code default =1. See memory heartbeat-rot-freezes-movement / CLAUDE.md.
WULFRAM_HEARTBEAT_ROT=0
WULFRAM_HEARTBEAT_POS=0
WULFRAM_SPAWN_RETRANSMIT=0
WULFRAM_SPAWN_UPDATE_ARRAY=0
WULFRAM_SPAWN_BOOTSTRAP_HEARTBEAT=0
WULFRAM_SPAWN_PLAYER_ACTIVE=0
WULFRAM_SPAWN_TANK_WEAPON_TYPE=2
WULFRAM_SEND_FULL_UPDATES=0
WULFRAM_MULTI_SPAWN_OFFSET=30
WULFRAM_AUTO_LOGIN=0
WULFRAM_SPAWN_POS=4950,5100,5
WULFRAM_TERRAIN_FILE=
# WULFRAM_AUTO_JOIN_TEAM removed from server (auto-spawn-on-timer crashed clients)
WULFRAM_SEND_WORLD_STATS_ON_LOGIN=1
# WULFRAM_SPAWN_ON_TEAM_SELECT removed from server (explicit spawn-point flow only)
WULFRAM_SPAWN_DELAY=0
WULFRAM_SPAWN_FORCE_AFTER=0
WULFRAM_SPAWN_REINCARNATE=0
WULFRAM_SPAWN_GAME_CLOCK=0
WULFRAM_SPAWN_COMM_MESSAGE=0
WULFRAM_REMOTE_IS_MANNED=1
WULFRAM_TEAM_SWITCH_UPDATE_STATS=1
WULFRAM_TEAM_SWITCH_UPDATE_STATS_TRANSPORT=udp
WULFRAM_TEAM_SWITCH_UPDATE_STATS_VARIANT=team_first
WULFRAM_TEAM_SWITCH_REINCARNATE=0
WULFRAM_TEAM_SWITCH_ROSTER=1
WULFRAM_TEAM_SWITCH_ENTRY_PACKETS=0

# --- Settings the Windows launcher (_start_server.ps1) sets but .env lacked. On DO the
# server runs via systemd with EnvironmentFile=.env (it does NOT self-load .env), so these
# MUST be here or the Goals 1-7 behavior differs from local. Added 2026-06-04 for the DO push.
# MANDATORY for the post-auto-spawn flow:
# NOTE: systemd EnvironmentFile does NOT strip inline comments, so every comment
# below MUST be on its own line or it poisons the value (see line ~52 + the
# periodic fix 3c10ce3). The settings below were added 2026-06-04 with INLINE
# comments that did exactly that on DO -> SERVER_PING_LOOP/SEND_SPAWN_POINTS/
# SPAWN_POINTS read as poisoned strings (!= "1") -> keepalive + spawn flags OFF.
# keepalive: OG client drops at deploy screen ~15s without it
WULFRAM_SERVER_PING_LOOP=1
# flag-click deploy needs flags to click
WULFRAM_SEND_SPAWN_POINTS=1
# the deployable spawn flags (team,x,y,z)
WULFRAM_SPAWN_POINTS=1,5050,4950,5;2,5050,5050,5
# Match the validated local tuning:
# UPDATE_ARRAY over TCP crashes OG client
WULFRAM_UPDATE_TCP=0
WULFRAM_LOCAL_STATE_WEAPON_TYPE=2
WULFRAM_SPAWN_PLAYER_INFO=1
WULFRAM_TURRET_AI=0
WULFRAM_TERRAIN_PITCH=1
# Live two-client OG measurement (2026-09-01): the old 6.0 low-hover planar
# damping made the server travel 23u while the predicting client traveled 78u.
# The tank PhysicsConfig coefficient is 1.5; do not add a second contact loss.
WULFRAM_TANK_GROUND_CONTACT_DAMP=1.5
WULFRAM_INACTIVITY_TIMEOUT=600
# Goal 2 gated-rare corrections (code default, explicit here)
WULFRAM_CORRECTION_GATE=1
# ROT-ONLY corrections (2026-06-30, decompile-grounded). Sending pos+rot in ONE local
# correction routes the OG client through Entity_reset_physics -> the attitude slerp
# (Interpolation.c:191 -> Quat_slerp Math.c:2455) whose acos(dot) is UNCLAMPED: when the
# client is well-synced the rotation delta is sub-epsilon, dot rounds >1.0, acos=NaN ->
# crash. Fires ~1-in-2 on a real-GPU/variable-fps client, never on WARP ~12fps (the exact
# host-vs-VM discrepancy). A pos-bearing VIEW_UPDATE is force-clamped to also carry rot, so
# rot-ONLY is the only crash-safe correction (benign branch, no reset_physics/slerp).
# Position stays client-predicted; physics parity keeps it synced on open ground.
# Own-line comment only (systemd EnvironmentFile does not strip inline comments).
# crashfix14 clamps the client NaN reservoirs before they escape into entity
# pose/physics, so a stopped full VIEW_UPDATE is now safe and actually corrects
# lateral drift. Never deploy this setting to an unpatched stock client.
WULFRAM_CORRECTION_ROT_ONLY=1
WULFRAM_SETTLED_MOVEMENT_CORRECTION=0
WULFRAM_SETTLED_MOVEMENT_CORRECTION_MAX_SPEED=0.5
WULFRAM_SETTLED_MOVEMENT_CORRECTION_MAX_ANGULAR_SPEED_DEG=1.0
WULFRAM_SETTLED_MOVEMENT_CORRECTION_BURST_COUNT=3
WULFRAM_SETTLED_MOVEMENT_CORRECTION_BURST_INTERVAL=0.1
# SPAWN-AT-REST + DUMMY-HEARTBEAT combo (2026-07-01) -- ATTEMPT to stop the post-spawn suspension NaN.
# UNTESTED: the related spawn-at-rest + heartbeat-SUPPRESS attempts were falsified 6/6 in f91a0a0
# (the client spring never sleeps). Dummy-entity is a DIFFERENT mechanism (null-entity heartbeat ->
# no RigidBody_wake) but has NOT been run against the repro. See docs/freeze-correction-arc-2026-07.md.
# spawn the tank AT its settled rest (no bounce -> zero velocity -> sleeps) AND send the
# health heartbeat on the null entity (no RigidBody_wake -> stays asleep -> spring stops).
# Ride height calibrated to the observed DO equilibrium (~3.25 above physics ground).
# Own-line comments only (systemd EnvironmentFile rule).
WULFRAM_SPAWN_SETTLE_TANK_Z=1
WULFRAM_SPAWN_SETTLE_RIDE_HEIGHT=3.25
WULFRAM_HEARTBEAT_DUMMY_ENTITY=1
# TEST 2026-07-01: never promote to full remote local-state (default 0.75s). The crash fires
# right after "promoted to full remote sync" at 0.75s -- the local_state bit-shape changes
# mid-stream (ammo/turret bits 0 -> nonzero) which can misalign the OG client bitstream. Huge
# delay = never promote = isolate whether the promotion is the deterministic ~0.75s crasher.
WULFRAM_REMOTE_FULL_LOCAL_STATE_DELAY=99999
# Periodic correction during movement -- INTENTIONALLY 0 (OFF). The "steady cadence" phrasing
# is historical (it described the old local/recording build); see the 2026-06-28 blowup note below.
# NOTE: own-line comment — systemd EnvironmentFile does NOT strip inline comments,
# and this value is float-parsed, so an inline "# ..." would poison it -> OFF.
# 2026-06-28: during-movement periodic corrections cause an INTERMITTENT (~1-in-2) client
# local-physics blowup (position runs away to huge coords, e.g. -186503, = frozen tank flung
# into space). Confirmed by the mouse-driving repro (host_drive.py --reprofreeze): one run
# blew up, one survived 70s -- timing-dependent race between correction cadence and the
# client's softbody integration. NOT safely fixable server-side. Off. Use fire-on-stop /
# jump-jet (velocity already ~0) for resync. See stale-held-input-spin-freeze memory.
WULFRAM_PERIODIC_CORRECTION_S=0
# FIRE-POSE LEAD (2026-06-29): shells fire along the body, which lags the mouse-aim/crosshair
# (compoundingly during a sustained turn). Extrapolate the fire yaw forward by angular velocity
# so shells lead toward the crosshair. Tune live with the `firelead <ticks>` control command.
WULFRAM_FIRE_POSE_LEAD_TICKS=0
# SKIP-FIRER: don't send the firer its own shell. This HID the firer's own projectiles
# (pulse shells invisible to the shooter). It was a test for the "fire freeze", but that
# freeze is now understood as the client suspension/slerp NaN family (unrelated to the
# projectile packet), so skip-firer has no benefit and only hides your own shells. OFF.
# Toggle live with `skipfirer 0|1`. (2026-07-01)
WULFRAM_PROJECTILE_SKIP_FIRER=0
# FIRE-FREEZE FIX (2026-06-27): each projectile spawns a thread streaming update packets
# (default mode 2 = 15Hz) to EVERY client incl. the firer. Rapid fire (esp. pulse shell)
# = many threads x 15Hz = a packet flood that stalls the firer's OG client loop -> a
# single-client freeze with NO corrections (input goes IDLE; observed on DO). Mode 0 =
# no per-tick updates (clients simulate from spawn velocity; pulse shells are fast +
# straight so this is accurate, and hit detection stays server-authoritative). Eliminates
# the flood.
WULFRAM_PROJECTILE_UPDATE_MODE=0
# FIRE-FREEZE FIX (re-verified 2026-09-01): the recovered 5.5u muzzle point is INSIDE the
# server tank's measured 8.55u bounding radius. At 12u, firer replication is safe: two live
# OG pulse shots survived for the full 5s lifetime, expired normally, and accepted post-fire
# movement; the multiplayer shot was also spawned/deleted to the remote OG client.
WULFRAM_PROJECTILE_SPAWN_OFFSET=12
# MULTIPLAYER-COMBAT-FREEZE FIX (2026-06-27): the STATE_REQUEST->settle-burst replies ride
# VIEW_UPDATE = snap-pose + ZERO VELOCITY on the OG client. In combat the client diverges,
# spams STATE_REQUEST, and the server answers each with a ~10Hz velocity-zeroing burst -> a
# self-sustaining loop that pins the tank (input IDLE; both clients froze in a fight on DO).
# Disable the STATE_REQUEST->burst loop. Periodic stays ON (it is movement-suppressed via
# the held-input fix, so it only clears drift when the player is stopped -- no freeze) and
# the divergence-GATED correction stays on (WULFRAM_CORRECTION_GATE=1). Own-line comments
# only (systemd EnvironmentFile rule).
WULFRAM_STATE_REQUEST_BURST=0
# 2026-09-02 stock-protocol local correction: answer each client STATE_REQUEST
# with one immediate VIEW_UPDATE (pos+vel+rot, fresh timestamp). This is the
# client's designed rubberband channel (Replication.c receive_entity_update ->
# EntityInterp_apply_delta); see server_corrections._send_stock_replay_reply.
WULFRAM_STATE_REQUEST_REPLAY_REPLY=1
WULFRAM_STATE_REQUEST_REPLAY_DURING_MOVEMENT=0
# Server ping cadence == client STATE_REQUEST cadence == correction cadence
# (client answers each 0x0B ping with a 0x0C request; replies come in a
# short burst until the client's outstanding-request cap of 5). Was 2.0.
WULFRAM_PING_INTERVAL_S=1.0
# Release-time velocity kicks (approximation of client-held input duration)
# fight the stock replay reply; movement kick OFF for A/B, turn kick kept.
WULFRAM_MOVEMENT_INTEGRAL_RECONCILE=0
WULFRAM_TURN_INTEGRAL_RECONCILE=0
WULFRAM_STATE_REQUEST_REPLAY_LEAD_TICKS=0
# Spread physics catch-up after a tick stall over ticks (1 step/tick) instead
# of a 5-step burst that jumps the server ahead of the client's predictor.
WULFRAM_MAX_CATCHUP_STEPS=1
# Keep the client's resting pull alive (Prediction.c validate_prediction aborts
# it when predicted vel == server vel exactly). 0 = stock-faithful.
WULFRAM_STATE_REQUEST_REPLAY_VEL_NUDGE=0
# Keep movement axes phase-aligned with turn.  The old 0.20s movement-only
# replay delay preserved straight-line distance but changed every turning arc.
WULFRAM_REMOTE_OG_MOVEMENT_INPUT_DELAY=0
WULFRAM_PHYSICS_FRAME_MATCH=1
WULFRAM_REMOTE_UPDATE_INTERVAL=0.05
# Live OG/server UTC-aligned trace (2026-09-01): the OG tank crossed Crossroads
# skypump PAD oid=10013 at (5064.3,5103.5), while the server's sphere-vs-mesh
# approximation kicked the authoritative tank 5u sideways. Pads are traversable;
# keep their server vehicle response off unless a later OG trace proves blocking.
WULFRAM_PAD_BLOCKS_VEHICLES=0
# WULFRAM_GOAL7_LEGACY unset => Goal 7 yaw stomp-fix ACTIVE (set =1 only to A/B the old behavior)

# --- Phase 3 construction subsystem (2026-06-27). Code defaults are ON; pinned here so
# the DO alpha behavior is explicit. Per the systemd EnvironmentFile rule above, every
# comment is on its OWN line (an inline "# ..." poisons the value -> feature silently off).
# Typed cargo boxes (type 0x13) replicate to the OG client (the type-0x13 wire field is
# written, so no more PROTOCOL ERROR desync):
WULFRAM_CARGO_BOX_ENTITY=1
# Cargo deploy (.) / drop (,) -> server build (DROP_REQUEST 0x2b):
WULFRAM_CARGO_DEPLOY=1
# Match flow: running round clock + round-end announce/reset. Long 30-min round so the
# reset/announce is rare and unobtrusive on the shared alpha (user choice 2026-06-27):
WULFRAM_MATCH_FLOW=1
WULFRAM_ROUND_TIME_S=86400

# ---- Community wire profile (2026-09-03, docs/community-parity-plan-2026-09-03.md) ----
# Match the wulfram3.com relay server as seen by a stock client: zero-entity VIEW_UPDATE
# local_state at 1 Hz idle / 20 Hz while health or energy < 1, UPDATE_ARRAY keepalives at
# 20 Hz, SHIP_STATUS + SUPPLY_SHIP_INFO 1 Hz per ship, GAME_CLOCK every 30 s, energy back to
# full in ~60 s (measured: pad-session-1).
WULFRAM_LOCAL_STATE_CADENCE=community
WULFRAM_LOCAL_STATE_IDLE_INTERVAL_S=1.0
WULFRAM_LOCAL_STATE_ACTIVE_INTERVAL_S=0.05
WULFRAM_SHIP_STATUS_INTERVAL_S=1.0
WULFRAM_MATCH_CLOCK_INTERVAL_S=30
WULFRAM_PLAYER_ENERGY_REGEN=1.7
