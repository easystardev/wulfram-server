WULFRAM_CORRECTION_INTERVAL=0
WULFRAM_SEND_PLAYER_UPDATES=1
WULFRAM_UPDATE_HEARTBEAT=0.1
# HEARTBEAT_ROT MUST be 0 for OG clients: =1 puts real single-entity rotation in the
# heartbeat UPDATE_ARRAY, which triggers the client's sync_local_player and FREEZES local
# movement (~30s in, while firing/fuel still work). The launcher set this; .env did not, so
# DO ran the code default =1. See memory heartbeat-rot-freezes-movement / CLAUDE.md.
WULFRAM_HEARTBEAT_ROT=0
WULFRAM_HEARTBEAT_POS=0
WULFRAM_SPAWN_RETRANSMIT=0
WULFRAM_SPAWN_UPDATE_ARRAY=0
WULFRAM_SPAWN_BOOTSTRAP_HEARTBEAT=0
WULFRAM_SPAWN_PLAYER_ACTIVE=0
WULFRAM_SPAWN_TANK_WEAPON_TYPE=2
WULFRAM_SEND_FULL_UPDATES=0
WULFRAM_MULTI_SPAWN_OFFSET=30
WULFRAM_AUTO_LOGIN=0
WULFRAM_SPAWN_POS=4950,5100,5
WULFRAM_TERRAIN_FILE=
# WULFRAM_AUTO_JOIN_TEAM removed from server (auto-spawn-on-timer crashed clients)
WULFRAM_SEND_WORLD_STATS_ON_LOGIN=1
# WULFRAM_SPAWN_ON_TEAM_SELECT removed from server (explicit spawn-point flow only)
WULFRAM_SPAWN_DELAY=0
WULFRAM_SPAWN_FORCE_AFTER=0
WULFRAM_SPAWN_REINCARNATE=0
WULFRAM_SPAWN_GAME_CLOCK=0
WULFRAM_SPAWN_COMM_MESSAGE=0
WULFRAM_REMOTE_IS_MANNED=1
WULFRAM_TEAM_SWITCH_UPDATE_STATS=1
WULFRAM_TEAM_SWITCH_UPDATE_STATS_TRANSPORT=udp
WULFRAM_TEAM_SWITCH_UPDATE_STATS_VARIANT=team_first
WULFRAM_TEAM_SWITCH_REINCARNATE=0
WULFRAM_TEAM_SWITCH_ROSTER=1
WULFRAM_TEAM_SWITCH_ENTRY_PACKETS=0

# --- Settings the Windows launcher (_start_server.ps1) sets but .env lacked. On DO the
# server runs via systemd with EnvironmentFile=.env (it does NOT self-load .env), so these
# MUST be here or the Goals 1-7 behavior differs from local. Added 2026-06-04 for the DO push.
# MANDATORY for the post-auto-spawn flow:
# NOTE: systemd EnvironmentFile does NOT strip inline comments, so every comment
# below MUST be on its own line or it poisons the value (see line ~52 + the
# periodic fix 3c10ce3). The settings below were added 2026-06-04 with INLINE
# comments that did exactly that on DO -> SERVER_PING_LOOP/SEND_SPAWN_POINTS/
# SPAWN_POINTS read as poisoned strings (!= "1") -> keepalive + spawn flags OFF.
# keepalive: OG client drops at deploy screen ~15s without it
WULFRAM_SERVER_PING_LOOP=1
# flag-click deploy needs flags to click
WULFRAM_SEND_SPAWN_POINTS=1
# the deployable spawn flags (team,x,y,z)
WULFRAM_SPAWN_POINTS=1,5050,4950,5;2,5050,5050,5
# Match the validated local tuning:
# UPDATE_ARRAY over TCP crashes OG client
WULFRAM_UPDATE_TCP=0
WULFRAM_LOCAL_STATE_WEAPON_TYPE=2
WULFRAM_SPAWN_PLAYER_INFO=1
WULFRAM_TURRET_AI=0
WULFRAM_TERRAIN_PITCH=1
WULFRAM_INACTIVITY_TIMEOUT=600
# Goal 2 gated-rare corrections (code default, explicit here)
WULFRAM_CORRECTION_GATE=1
# steady-cadence correction during movement (matches local/recording build).
# NOTE: own-line comment — systemd EnvironmentFile does NOT strip inline comments,
# and this value is float-parsed, so an inline "# ..." would poison it -> OFF.
WULFRAM_PERIODIC_CORRECTION_S=0
# MOVEMENT-FREEZE FIX (2026-06-27): the proactive correction streams ride VIEW_UPDATE,
# which the OG client applies as snap-pose + ZERO VELOCITY. Under real latency + combat
# + multiplayer, the OG client's prediction diverges, it spams STATE_REQUEST, and the
# server answers each with a ~10Hz velocity-zeroing settle-burst -> a self-sustaining
# loop that pins the tank (input goes IDLE, can't move; both clients froze in combat on
# DO). Disable the STATE_REQUEST->burst loop and the idle periodic stream; keep only the
# rare divergence-GATED correction (WULFRAM_CORRECTION_GATE=1). The OG client runs its
# own deterministic prediction (CLAUDE.md), so flat-ground play needs no proactive
# corrections. Own-line comments only (systemd EnvironmentFile rule).
WULFRAM_STATE_REQUEST_BURST=0
# WULFRAM_GOAL7_LEGACY unset => Goal 7 yaw stomp-fix ACTIVE (set =1 only to A/B the old behavior)

# --- Phase 3 construction subsystem (2026-06-27). Code defaults are ON; pinned here so
# the DO alpha behavior is explicit. Per the systemd EnvironmentFile rule above, every
# comment is on its OWN line (an inline "# ..." poisons the value -> feature silently off).
# Typed cargo boxes (type 0x13) replicate to the OG client (the type-0x13 wire field is
# written, so no more PROTOCOL ERROR desync):
WULFRAM_CARGO_BOX_ENTITY=1
# Cargo deploy (.) / drop (,) -> server build (DROP_REQUEST 0x2b):
WULFRAM_CARGO_DEPLOY=1
# Match flow: running round clock + round-end announce/reset. Long 30-min round so the
# reset/announce is rare and unobtrusive on the shared alpha (user choice 2026-06-27):
WULFRAM_MATCH_FLOW=1
WULFRAM_ROUND_TIME_S=1800
